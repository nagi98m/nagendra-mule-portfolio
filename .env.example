# REQUIRED IN PRODUCTION: canonical HTTPS origin for SEO and social metadata.
NEXT_PUBLIC_SITE_URL=

# REQUIRED IN PRODUCTION: deployed FastAPI HTTPS origin.
NEXT_PUBLIC_API_URL=

# OPTIONAL PROFILE DATA: set only verified public values. Blank values are hidden safely.
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_CONTACT_EMAIL=

# LOCAL OWNER TOOL ONLY: keep false/undefined in production so /resume-admin returns 404.
ENABLE_RESUME_ADMIN=false
