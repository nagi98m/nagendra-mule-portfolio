# REQUIRED IN PRODUCTION: replace these development values with exact frontend HTTPS origins. Never use *.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# OPTIONAL: hosting platforms may inject PORT; the container defaults to 8000.
PORT=8000

# OPTIONAL: blank key/model keeps the grounded local extractive fallback active.
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=https://api.openai.com/v1
LLM_AUTH_HEADER=Authorization

# OPTIONAL TUNING: safe defaults are used when omitted.
RETRIEVAL_TOP_K=4
CHAT_RATE_LIMIT=12
CHAT_RATE_WINDOW_SECONDS=60
